/*
 * Ascend AIV-only PoW scanner. No Cube/AIC, no global mailboxes,
 * no inter-core flags, no per-nonce GM intermediates.
 *
 * The 128-byte constant buffer is produced once per fresh challenge on
 * the C++ host: bytes 0..31 contain 8 x host-endian SHA256 midstate words;
 * bytes 32..90 contain the remaining 59 fixed challenge bytes.
 * Everything needed for a nonce is then local to its AIV block.
 *
 * Experimental CANN 9.x hybrid ASC; not validated on 910B/910C hardware.
 */
#include <stdint.h>
#include <cstring>
#include <chrono>
#include <algorithm>
#include <mutex>
#include "acl/acl.h"
#include "kernel_operator.h"
#define TAO_INLINE __aicore__ inline
#include "tao_hash_core.h"
#undef TAO_INLINE
// C++-only host implementations prevent invoking device-only arithmetic on host.
extern "C" void tao_prepare_host(const uint8_t*,uint8_t*);
extern "C" int tao_verify_host(const uint8_t*,uint64_t,const uint8_t*,const uint8_t*);

// 64-byte isolated cache-line records, one per AIV worker.
// [0]=found, [1,2]=nonce, [3..10]=real AIV-computed digest.
__global__ __vector__ void tao_pow_scan(__gm__ uint8_t* preparedD,
    __gm__ uint8_t* targetD, __gm__ uint32_t* resultD,
    uint64_t start, uint32_t attempts, uint32_t grid) {
    const uint32_t worker=(uint32_t)AscendC::GetBlockIdx();
    if (worker >= grid) return;
    __gm__ uint32_t* result=resultD + ((uint64_t)worker * 16U);
    result[0]=0;

    // Read once per worker/launch; not once per hash.
    uint32_t midstate[8];
    uint8_t tail[128]={0};
    uint8_t target[32];
    for (int i=0;i<8;++i) {
        uint32_t o=(uint32_t)(4*i);
        midstate[i]=(uint32_t)preparedD[o] |
                    ((uint32_t)preparedD[o+1]<<8) |
                    ((uint32_t)preparedD[o+2]<<16) |
                    ((uint32_t)preparedD[o+3]<<24);
    }
    for (int i=0;i<59;++i) tail[i]=preparedD[32+i];
    for (int i=0;i<32;++i) target[i]=targetD[i];
    // SHA256 of 123 challenge bytes + 8-byte nonce = 131 bytes.
    // Block 2 consists of 3 trailing nonce bytes and padding.
    tail[67]=0x80;
    tail[126]=0x04;
    tail[127]=0x18;

    for (uint64_t offset=worker; offset<(uint64_t)attempts; offset+=grid) {
        const uint64_t nonce=start+offset;
        uint8_t seal[32];
        tao_make_seal(midstate,tail,nonce,seal);
        if (tao_meets_target(seal,target)) {
            result[1]=(uint32_t)nonce;
            result[2]=(uint32_t)(nonce>>32);
            for (int i=0;i<8;++i) {
                int j=4*i;
                result[3+i]=(uint32_t)seal[j] | ((uint32_t)seal[j+1]<<8) |
                            ((uint32_t)seal[j+2]<<16) | ((uint32_t)seal[j+3]<<24);
            }
            result[0]=1;
            dcci(result, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
            return;
        }
    }
    dcci(result, cache_line_t::SINGLE_CACHE_LINE, dcci_dst_t::CACHELINE_OUT);
}

struct TaoContext {
    int device;
    uint32_t grid;
    aclrtStream stream;
    uint8_t *preparedD, *targetD;
    uint32_t *resultD, *resultH;
    uint8_t *preparedH, *targetH; // pinned host upload staging, persistent
    uint8_t prefixCache[123], targetCache[32];
    bool cachedPrefix, cachedTarget;
    std::mutex lock;
    TaoContext():device(-1),grid(0),stream(nullptr),preparedD(nullptr),
        targetD(nullptr),resultD(nullptr),resultH(nullptr),preparedH(nullptr),
        targetH(nullptr),cachedPrefix(false),cachedTarget(false) {}
};

static std::once_flag g_acl_once;
static int g_init_status=-1;
static int tao_acl_start() {
    std::call_once(g_acl_once,[](){g_init_status=(int)aclInit(nullptr);});
    return g_init_status;
}
static void tao_release(TaoContext* ctx) {
    if (!ctx) return;
    if (ctx->device>=0) aclrtSetDevice(ctx->device);
    if (ctx->stream) aclrtSynchronizeStream(ctx->stream);
    if (ctx->preparedD) aclrtFree(ctx->preparedD);
    if (ctx->targetD) aclrtFree(ctx->targetD);
    if (ctx->resultD) aclrtFree(ctx->resultD);
    if (ctx->preparedH) aclrtFreeHost(ctx->preparedH);
    if (ctx->targetH) aclrtFreeHost(ctx->targetH);
    if (ctx->resultH) aclrtFreeHost(ctx->resultH);
    if (ctx->stream) aclrtDestroyStream(ctx->stream);
    delete ctx;
}

extern "C" int tao_api_version() { return 3; }
extern "C" int tao_create(int device,uint32_t grid,void** output) {
    if (!output || device<0 || grid<1 || grid>80) return -1;
    *output=nullptr;
    int rc=tao_acl_start(); if (rc) return rc;
    TaoContext* ctx=new TaoContext();
    ctx->device=device;ctx->grid=grid;
    rc=(int)aclrtSetDevice(device);
    if (!rc) rc=(int)aclrtCreateStream(&ctx->stream);
    if (!rc) rc=(int)aclrtMalloc((void**)&ctx->preparedD,128,ACL_MEM_MALLOC_HUGE_FIRST);
    if (!rc) rc=(int)aclrtMalloc((void**)&ctx->targetD,32,ACL_MEM_MALLOC_HUGE_FIRST);
    const size_t bytes=(size_t)grid*16*sizeof(uint32_t);
    if (!rc) rc=(int)aclrtMalloc((void**)&ctx->resultD,bytes,ACL_MEM_MALLOC_HUGE_FIRST);
    if (!rc) rc=(int)aclrtMallocHost((void**)&ctx->resultH,bytes);
    if (!rc) rc=(int)aclrtMallocHost((void**)&ctx->preparedH,128);
    if (!rc) rc=(int)aclrtMallocHost((void**)&ctx->targetH,32);
    if (rc) {tao_release(ctx);return rc;}
    *output=ctx;
    return 0;
}

// Single NPU launch, called exclusively through the native C ABI.
extern "C" int tao_mine(void* raw,const uint8_t* prefix,const uint8_t* target,
    uint64_t start,uint32_t attempts,uint64_t* answer,int* found,uint8_t* sealOut) {
    if (!raw || !prefix || !target || !answer || !found || !sealOut ||
        attempts==0 || attempts>1048576U) return -1;
    TaoContext* ctx=(TaoContext*)raw;
    std::lock_guard<std::mutex> guard(ctx->lock);
    *found=0;*answer=0;
    int rc=(int)aclrtSetDevice(ctx->device); if (rc) return rc;
    if (!ctx->cachedPrefix || std::memcmp(ctx->prefixCache,prefix,123)!=0) {
        tao_prepare_host(prefix,ctx->preparedH);
        rc=(int)aclrtMemcpyAsync(ctx->preparedD,128,ctx->preparedH,128,
                                 ACL_MEMCPY_HOST_TO_DEVICE,ctx->stream);
        if (rc) {ctx->cachedPrefix=false;return rc;}
        std::memcpy(ctx->prefixCache,prefix,123);
        ctx->cachedPrefix=true;
    }
    if (!ctx->cachedTarget || std::memcmp(ctx->targetCache,target,32)!=0) {
        std::memcpy(ctx->targetH,target,32);
        rc=(int)aclrtMemcpyAsync(ctx->targetD,32,ctx->targetH,32,
                                 ACL_MEMCPY_HOST_TO_DEVICE,ctx->stream);
        if (rc) {ctx->cachedPrefix=false;ctx->cachedTarget=false;return rc;}
        std::memcpy(ctx->targetCache,target,32);
        ctx->cachedTarget=true;
    }
    tao_pow_scan<<<ctx->grid,nullptr,ctx->stream>>>(ctx->preparedD,ctx->targetD,
        ctx->resultD,start,attempts,ctx->grid);
    const size_t bytes=(size_t)ctx->grid*16*sizeof(uint32_t);
    rc=(int)aclrtMemcpyAsync(ctx->resultH,bytes,ctx->resultD,bytes,
                             ACL_MEMCPY_DEVICE_TO_HOST,ctx->stream);
    if (rc) {ctx->cachedPrefix=false;ctx->cachedTarget=false;return rc;}
    rc=(int)aclrtSynchronizeStream(ctx->stream);
    if (rc) {ctx->cachedPrefix=false;ctx->cachedTarget=false;return rc;}
    for (uint32_t worker=0;worker<ctx->grid;++worker) {
        uint32_t* p=ctx->resultH+worker*16;
        if (p[0]) {
            const uint64_t nonce=(uint64_t)p[1]|((uint64_t)p[2]<<32);
            for (int i=0;i<8;++i) {
                uint32_t x=p[3+i];
                for (int j=0;j<4;++j) sealOut[4*i+j]=(uint8_t)(x>>(8*j));
            }
            // Recompute only a returned candidate, never a full CPU scan.
            if ((uint64_t)(nonce-start)>=attempts ||
                !tao_verify_host(prefix,nonce,target,sealOut)) return -2;
            *answer=nonce;*found=1;
            return 0;
        }
    }
    return 0;
}

// Native chunked scanning: one C ABI invocation dispatches
// several AIV launches without host-language interpreter overhead.
// max_ms is a soft deadline checked between non-preemptible kernel launches.
extern "C" int tao_mine_window(void* raw,const uint8_t* prefix,const uint8_t* target,
    uint64_t start,uint64_t attempts,uint32_t chunk,uint32_t max_ms,
    uint64_t* answer,int* found,uint8_t* sealOut,uint64_t* scanned) {
    if (!raw || !prefix || !target || !answer || !found || !sealOut || !scanned ||
        !attempts || attempts>0x100000000ULL || !chunk || chunk>1048576U ||
        !max_ms || max_ms>60000U) return -1;
    *answer=0;*found=0;*scanned=0;
    const auto deadline=std::chrono::steady_clock::now()+std::chrono::milliseconds(max_ms);
    while (*scanned<attempts) {
        if (std::chrono::steady_clock::now()>=deadline) break;
        const uint32_t count=(uint32_t)std::min<uint64_t>(chunk,attempts-*scanned);
        uint64_t nonce=0;int got=0;uint8_t seal[32]={0};
        int rc=tao_mine(raw,prefix,target,start+*scanned,count,&nonce,&got,seal);
        if (rc) return rc;
        *scanned+=count;
        if (got) {
            *answer=nonce;*found=1;
            std::memcpy(sealOut,seal,32);
            break;
        }
    }
    return 0;
}

extern "C" void tao_destroy(void* raw) {tao_release((TaoContext*)raw);}
