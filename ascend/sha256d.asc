/*
 * Experimental ASC AIV-only SHA256d pool scanner. No AIC/Cube, flags,
 * intercore synchronization or per-nonce GM traffic.
 * Native network code is independent: shares are verified and submitted
 * by the host. CANN / Ascend 910B, 910C compilation and runtime unverified.
 */
#include <stdint.h>
#include <cstring>
#include <mutex>
#include <algorithm>
#include "acl/acl.h"
#include "kernel_operator.h"
#define TAO_INLINE __aicore__ inline
#include "sha256d_core.h"
#undef TAO_INLINE

extern "C" void th_host_prepare(const uint8_t *, uint8_t *);
extern "C" int th_host_verify(const uint8_t *, const uint8_t *, uint32_t, const uint8_t *);

/* Worker records: 64 B / AIV; found, nonce, 8x uint32 digest. */
__global__ __vector__ void th_scan_kernel(__gm__ uint8_t *prep,
     __gm__ uint8_t *targetD, __gm__ uint32_t *results,
     uint32_t start, uint32_t count, uint32_t grid) {
    const uint32_t worker=(uint32_t)AscendC::GetBlockIdx();
    if(worker>=grid) return;
    __gm__ uint32_t *r=results+(uint64_t)worker*16U;
    r[0]=0;
    uint32_t mid[8]; uint8_t tail[64]; uint8_t target[32];
    for (int i=0;i<8;++i) {
        uint32_t j=(uint32_t)(i*4);
        mid[i]=(uint32_t)prep[j]|((uint32_t)prep[j+1]<<8)|
               ((uint32_t)prep[j+2]<<16)|((uint32_t)prep[j+3]<<24);
    }
    for (int j=0;j<64;++j) tail[j]=prep[32+j];
    for (int j=0;j<32;++j) target[j]=targetD[j];
    for (uint64_t i=worker;i<(uint64_t)count;i+=grid) {
        const uint32_t nonce=start+(uint32_t)i;
        uint8_t digest[32];th_hash_midstate(mid,tail,nonce,digest);
        if (th_under_target(digest,target)) {
            r[1]=nonce;
            for (int j=0;j<8;++j) {
                int k=j*4;
                r[2+j]=(uint32_t)digest[k]|((uint32_t)digest[k+1]<<8)|
                      ((uint32_t)digest[k+2]<<16)|((uint32_t)digest[k+3]<<24);
            }
            r[0]=1;
            dcci(r,cache_line_t::SINGLE_CACHE_LINE,dcci_dst_t::CACHELINE_OUT);
            return;
        }
    }
    dcci(r,cache_line_t::SINGLE_CACHE_LINE,dcci_dst_t::CACHELINE_OUT);
}

struct ThContext {
    int device=-1;uint32_t grid=0;aclrtStream stream=nullptr;
    uint8_t *prepD=nullptr,*targetD=nullptr,*prepH=nullptr,*targetH=nullptr;
    uint32_t *resultD=nullptr,*resultH=nullptr;
    uint8_t headerCache[80]={0},targetCache[32]={0};
    bool cachedHeader=false,cachedTarget=false;
    std::mutex mutex;
};
static std::once_flag initOnce;
static int initStatus=-1;
static int acl_start() {
    std::call_once(initOnce,[](){initStatus=(int)aclInit(nullptr);});
    return initStatus;
}
static void release_ctx(ThContext *c) {
    if(!c)return;
    if(c->device>=0)aclrtSetDevice(c->device);
    if(c->stream)aclrtSynchronizeStream(c->stream);
    if(c->prepD)aclrtFree(c->prepD);
    if(c->targetD)aclrtFree(c->targetD);
    if(c->resultD)aclrtFree(c->resultD);
    if(c->prepH)aclrtFreeHost(c->prepH);
    if(c->targetH)aclrtFreeHost(c->targetH);
    if(c->resultH)aclrtFreeHost(c->resultH);
    if(c->stream)aclrtDestroyStream(c->stream);
    delete c;
}
extern "C" int th_create(int device,uint32_t grid,void **out) {
    if(!out||device<0||grid==0||grid>80)return -1;
    *out=nullptr;int rc=acl_start();if(rc)return rc;
    ThContext *c=new ThContext();c->device=device;c->grid=grid;
    rc=(int)aclrtSetDevice(device);
    if(!rc)rc=(int)aclrtCreateStream(&c->stream);
    if(!rc)rc=(int)aclrtMalloc((void**)&c->prepD,128,ACL_MEM_MALLOC_HUGE_FIRST);
    if(!rc)rc=(int)aclrtMalloc((void**)&c->targetD,32,ACL_MEM_MALLOC_HUGE_FIRST);
    size_t n=(size_t)grid*16*sizeof(uint32_t);
    if(!rc)rc=(int)aclrtMalloc((void**)&c->resultD,n,ACL_MEM_MALLOC_HUGE_FIRST);
    if(!rc)rc=(int)aclrtMallocHost((void**)&c->resultH,n);
    if(!rc)rc=(int)aclrtMallocHost((void**)&c->prepH,128);
    if(!rc)rc=(int)aclrtMallocHost((void**)&c->targetH,32);
    if(rc){release_ctx(c);return rc;}
    *out=c;return 0;
}
extern "C" int th_scan(void *opaque,const uint8_t *header,const uint8_t *target,
    uint32_t start,uint32_t attempts,uint32_t *answer,int *found,uint8_t *digestOut) {
    if(!opaque||!header||!target||!answer||!found||!digestOut||
        !attempts||attempts>1048576U|| (uint64_t)start+attempts>0x100000000ULL)return -1;
    ThContext *c=(ThContext*)opaque;
    std::lock_guard<std::mutex> lock(c->mutex);
    *found=0;*answer=0;
    int rc=(int)aclrtSetDevice(c->device);if(rc)return rc;
    if(!c->cachedHeader||std::memcmp(c->headerCache,header,80)!=0) {
        th_host_prepare(header,c->prepH);
        rc=(int)aclrtMemcpyAsync(c->prepD,128,c->prepH,128,ACL_MEMCPY_HOST_TO_DEVICE,c->stream);
        if(rc){c->cachedHeader=false;return rc;}
        std::memcpy(c->headerCache,header,80);c->cachedHeader=true;
    }
    if(!c->cachedTarget||std::memcmp(c->targetCache,target,32)!=0) {
        std::memcpy(c->targetH,target,32);
        rc=(int)aclrtMemcpyAsync(c->targetD,32,c->targetH,32,ACL_MEMCPY_HOST_TO_DEVICE,c->stream);
        if(rc){c->cachedHeader=false;c->cachedTarget=false;return rc;}
        std::memcpy(c->targetCache,target,32);c->cachedTarget=true;
    }
    th_scan_kernel<<<c->grid,nullptr,c->stream>>>(c->prepD,c->targetD,c->resultD,start,attempts,c->grid);
    size_t n=(size_t)c->grid*16*sizeof(uint32_t);
    rc=(int)aclrtMemcpyAsync(c->resultH,n,c->resultD,n,ACL_MEMCPY_DEVICE_TO_HOST,c->stream);
    if(rc){c->cachedHeader=false;c->cachedTarget=false;return rc;}
    rc=(int)aclrtSynchronizeStream(c->stream);
    if(rc){c->cachedHeader=false;c->cachedTarget=false;return rc;}
    for(uint32_t i=0;i<c->grid;++i){
        uint32_t *r=c->resultH+i*16;
        if(r[0]) {
            uint32_t nonce=r[1];
            for(int k=0;k<8;++k)for(int j=0;j<4;++j)
                digestOut[4*k+j]=(uint8_t)(r[2+k]>>(j*8));
            if(nonce<start||(uint64_t)nonce>=((uint64_t)start+attempts)||
               !th_host_verify(header,target,nonce,digestOut))return -2;
            *found=1;*answer=nonce;return 0;
        }
    }
    return 0;
}
extern "C" void th_destroy(void *ctx) {release_ctx((ThContext*)ctx);}
